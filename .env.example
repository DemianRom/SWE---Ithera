# Variables que docker compose usa para construir el frontend (compose.yaml).
# Son públicas: terminan dentro del bundle de JavaScript.
# Copia este archivo a .env (en la raíz del repo) y llena los valores.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Inicio de sesión social habilitado en Supabase (vacío = solo correo). Ej: google
VITE_OAUTH_PROVIDERS=
# Google Maps Platform (opcional): sugerencias de lugares y mapa del itinerario.
# Llave de navegador restringida por dominio (Maps JavaScript API + Places API (New)).
VITE_GOOGLE_MAPS_API_KEY=
# Map ID para los marcadores (vacío = DEMO_MAP_ID de Google).
VITE_GOOGLE_MAPS_MAP_ID=
