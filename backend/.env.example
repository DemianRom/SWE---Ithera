SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Correo saliente por SMTP (p. ej. Gmail con contraseña de aplicación).
# En Gmail, MAIL_FROM debe usar la misma cuenta que SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Traveling <tu-cuenta@gmail.com>

# Firma de los enlaces públicos del itinerario (openssl rand -hex 32)
SHARE_LINK_SECRET=
